{
  "name": "agentos",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/Jarvissilva/agentos.git"
  },
  "bugs": {
    "url": "https://github.com/Jarvissilva/agentos/issues"
  },
  "homepage": "https://github.com/Jarvissilva/agentos#readme",
  "type": "module",
  "engines": {
    "bun": ">=1.4.3"
  },
  "packageManager": "bun@1.4.3",
  "bin": {
    "agentos": "./src/index.ts"
  },
  "scripts": {
    "start": "bun src/index.ts",
    "dev": "bun --watch src/index.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "check": "bun run typecheck && bun run lint && bun test",
    "db:generate": "drizzle-kit generate",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@iarna/toml": "2.2.5",
    "@opentui/core": "0.6.6",
    "@opentui/react": "0.6.6",
    "commander": "15.0.0",
    "cron-parser": "5.10.2",
    "drizzle-orm": "0.45.4",
    "jsonc-parser": "3.3.1",
    "react": "19.3.1",
    "ws": "8.22.0",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/bun": "1.4.3",
    "@types/react": "19.3.0",
    "@types/ws": "8.18.2",
    "drizzle-kit": "0.31.11",
    "typescript": "7.0.2"
  }
}
